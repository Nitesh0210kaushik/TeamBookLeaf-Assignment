# Copy to `.env` (git-ignored). No secrets belong here — anything prefixed VITE_ is bundled
# into the browser code, and the AI key lives only in backend/.env.

# Base URL of the backend API used by the app. Keep the default when the frontend is served by
# the backend (production) or through the dev proxy below; set a full URL otherwise.
VITE_API_BASE_URL=/api/v1

# Dev server only (not exposed to the browser).
DEV_SERVER_PORT=5171
API_PROXY_TARGET=http://localhost:5000
