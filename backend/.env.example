# Copy to `.env` and fill in values. `.env` is git-ignored — never commit real secrets.

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (the Vite dev server by default).
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf_support

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
AUTH_COOKIE_NAME=bookleaf_session
# Set to true when served over HTTPS (always true in production).
COOKIE_SECURE=false

# --- AI (Anthropic Claude) -------------------------------------------------
# Leave empty to run without AI: tickets are still created, classified by the
# rule-based fallback, and admins get template drafts to edit.
ANTHROPIC_API_KEY=
AI_TRIAGE_MODEL=claude-opus-5-5
AI_DRAFT_MODEL=claude-opus-5-5
AI_TRIAGE_TIMEOUT_MS=20000
AI_DRAFT_TIMEOUT_MS=45000
# Circuit breaker: after N consecutive provider failures, skip AI calls for the cooldown.
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=60000

LOG_LEVEL=info
