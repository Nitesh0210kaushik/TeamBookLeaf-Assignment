# ---------------------------------------------------------------
# Secrets — never commit real credentials.
# Only the *.env.example templates are tracked.
# ---------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# Dependencies
node_modules/
.npm-cache/
.pnpm-store/

# Build output
dist/
build/
out/
.vite/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/

# Local database data
.local-mongo/
data/db/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Personal notes stay local (e.g. PROJECT_DOCUMENTATION.md).
# Submission docs required by the assignment are re-included below.
*.md
!README.md
!**/README.md
!WRITEUP.md
!docs/**/*.md

# Office temp files
~$*
